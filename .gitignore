# Python
__pycache__/
*.pyc

# SQLite transient (the .db itself IS tracked — it's the artifact)
*.db-wal
*.db-shm

# OS
.DS_Store
Thumbs.db

# Build caches (e.g. Unsloth's compiled kernels) — never committed
unsloth_compiled_cache/
.venv/
node_modules/

# rust-knowledge compile oracle: cargo build output (~hundreds of MB, machine-specific rlib paths).
# oracle/Cargo.toml + Cargo.lock ARE tracked — they pin the dependency set a check may link.
rust-knowledge/oracle/target/
# the si-jam-sessions tier's oracle set (wave 4): same rule, its own build output.
rust-knowledge/oracle-jam/target/

# headless preview screenshots (generated for verification)
_preview*.png
_v_*.png

# confirmation-run audio fixtures (binaries; provenance + hashes live in the
# adjacent run-receipts docs — re-pullable from cloud storage by job id)
model-knowledge/dialogs/comfy-agent/outputs/

# Generated production audio (run-artifact folders; re-pullable by job id — see wave receipts)
model-knowledge/generated/

# prism verification scratch — receipts are regenerated per run; the durable
# record is each KB's verification/ folder and the wave provenance
prism-out.json
docs/unverified/*prism*.json

# One-off audio-line collection scripts (internal production, not KB content)
model-knowledge/workflows/audio/scripts/

# NEVER COMMIT — carries a personal email address supplied for a vendor
# follow-up. Kept on disk as the record of what was sent; committing it would
# put the address in git history, where it cannot be removed.
model-knowledge/dialogs/comfy-agent/2026-08-23-comfy-feedback-submission-receipt.md
.swarm/

# Internal handoff — carries a home path and verbatim Director speech; the
# canonical copy lives in the private notes store, not in a published KB.
vocology-knowledge/waves/wave-02-music-language/fable-timing-handoff.md

# The public repo's landing page + handbook. It lives at public/site/ here and at
# site/ in the published tree; these patterns match both.
**/site/.astro/
**/site/dist/

# polyglot translation cache (README translations)
.polyglot-cache.json
# the law's midly configuration (wave 5): same rule, its own build output.
rust-knowledge/oracle-jam-strict/target/
# a chat seat's prompt files quote pinned crate source without its licence notice; the receipt keeps their hashes
rust-knowledge/waves/*/seats/*/*.system.txt
rust-knowledge/waves/*/seats/*/*.user.txt
